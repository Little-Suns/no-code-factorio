# Скопируй в .env и заполни. Без LLM_API_KEY сервер работает в мок-режиме
# (страховка для демо без ключа/интернета, фронт этого не отличает).

# Ключ OpenAI-compatible API. По умолчанию используется OpenRouter:
# https://openrouter.ai/keys
LLM_API_KEY=

# Базовый URL API. Можно указать любой OpenAI-compatible эндпоинт
# (например, свой self-hosted или другого провайдера).
LLM_BASE_URL=https://openrouter.ai/api/v1

# Модель по умолчанию — быстрая и дешёвая.
LLM_MODEL=openai/gpt-4o-mini
